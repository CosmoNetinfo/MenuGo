# MenuGo - Variabili d'ambiente di esempio
# Copia questo file in .env.local e inserisci i valori reali del tuo progetto.
# NON committare mai .env o .env.local nel repository.

# URL base dell'applicazione
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (dedicato a MenuGo)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Chiave con permessi di servizio (solo lato server, mai esporre al client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe (opzionale, configurabile per singolo locale)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
